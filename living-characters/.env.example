# ─── Living Characters — environment ────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...
# Model for character + world reasoning. Default: claude-opus-5-5
LLM_MODEL=claude-opus-5-5
# "default" enables server-side refusal fallbacks (recommended), "off" disables
LLM_FALLBACKS=default
# "claude" for real API, "mock" for an offline rule-based stand-in (tests / dry runs)
LLM_PROVIDER=claude

# Telegram — character bot (the one the user talks to, profile named after the character)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Only this chat ever receives character messages. Get it from the admin bot (/whoami)
# or by sending a message to the character bot and running `npm run admin -- whoami`.
ALLOWED_CHAT_ID=
# Optional second bot for admin commands (keeps control out of the character chat)
ADMIN_BOT_TOKEN=
# Chat IDs allowed to issue admin commands on the admin bot (comma separated)
ADMIN_CHAT_IDS=

# Admin HTTP API (used by `npm run admin`) — set a long random token
ADMIN_PORT=8787
ADMIN_TOKEN=change-me
# Base URL the CLI calls (default http://127.0.0.1:8787)
ADMIN_URL=http://127.0.0.1:8787

# Simulation timing (all in real time; sim time is 1:1 unless fast-forwarded)
TICK_INTERVAL_SEC=120          # world tick cadence (60–300 recommended)
SCHEDULER_POLL_SEC=5           # how often due events are checked
FIXED_EVENT_OFFSET_MIN=120     # the accident fires exactly this many minutes after start
# Allow the Fast Forward admin command. Set false for the live demo.
ALLOW_FAST_FORWARD=true

# Storage
DB_PATH=./data/living.db
TZ=Asia/Seoul
LOG_LEVEL=info
